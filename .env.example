# Rate-Limited LLM Proxy — environment configuration
# Copy this file to .env and fill in your real values:
#   copy .env.example .env
# The proxy auto-loads .env on startup.
# Legacy NVIDIA_* names remain supported, but UPSTREAM_* names take precedence.

# API key used by the proxy for upstream calls
UPSTREAM_API_KEY=your-real-upstream-api-key-here

# OpenAI-compatible upstream API base URL
# UPSTREAM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model used when a client sends an unknown model name (TC-027)
# UPSTREAM_DEFAULT_MODEL=meta/llama-3.3-70b-instruct

# Comma-separated list of valid upstream models (passed through untouched).
# Override if you use models not in the default list.
# UPSTREAM_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,meta/llama-3.3-70b-instruct,z-ai/glm-5.2

# true = rewrite unknown client models to UPSTREAM_DEFAULT_MODEL (defensive, TC-027)
# false = pass unknown models through as-is
# REWRITE_UNKNOWN_MODELS=true

# --- Rate limiter -----------------------------------------------------------
# Max requests per minute (window size)
# MAX_RPM=40
# Window length in seconds
# WINDOW_SIZE=60
# Max queue depth before rejecting with 503 + Retry-After (TC-029)
# MAX_QUEUE=500
# Seconds before a queued low-priority request is promoted to priority 1 (TC-017)
# RETRY_TTL=300

# --- Upstream HTTP behavior --------------------------------------------------
# Retries on upstream 429 and 503 with exponential backoff (TC-018)
# HTTP_RETRIES=3
# Backoff base seconds: sleeps base, base*2, base*4
# BACKOFF_BASE=1.0
# httpx timeouts (seconds)
# CONNECT_TIMEOUT=30
# READ_TIMEOUT=60
# WRITE_TIMEOUT=30
# POOL_TIMEOUT=30
# Max age of an in-flight stream before the sweeper force-releases it (TC-020)
# MAX_STREAM_AGE=300
# Sweeper interval in seconds
# SWEEP_INTERVAL=5

# --- Priority / payload -------------------------------------------------------
# Payload size (bytes) above which a request defaults to priority 5 when no
# X-Priority header is present (TC-025)
# LARGE_BODY_BYTES=262144

# --- Server -------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
# Show an in-place terminal dashboard and silence console logs
# DASHBOARD_ENABLED=false
